# =============================================================
# .env.root-sample (Version-controlled, non-secret)
# Copy to .env.alpha-vantage-proxy-api at the repo root and fill values locally.
# Do NOT commit real secrets.
# =============================================================

# -------- Project & Environment --------
GOOGLE_CLOUD_PROJECT=alpha-vantage-proxy-api
NODE_ENV=development

# -------- Alpha Vantage --------
# Primary API key (local tooling only; prod uses Secret Manager)
ALPHAVANTAGE_API_KEY=

# Emulator-only convenience (Functions emulator reads from functions/.env.*)
LOCAL_EMULATOR_ALPHAVANTAGE_API_KEY=

# -------- Benzinga --------
# Main token used by shared clients
BENZINGA_API_KEY=

# Optional per-feature keys
# BENZINGA_NEWS_API_KEY=
# BENZINGA_CALENDAR_API_KEY=

# -------- Partner/Webhook Auth (OIDC allowlist) --------
# Comma-separated service account emails allowed to call protected endpoints
ALLOWED_SERVICE_ACCOUNT_EMAILS=maintenance-bot@alpha-vantage-proxy-api.iam.gserviceaccount.com

# -------- Firebase Emulators --------
# Match firebase.json where pubsub.port is set to 8086
PUBSUB_EMULATOR_HOST=127.0.0.1:8086
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIRESTORE_EMULATOR_HOST=localhost:8080

# -------- Misc (optional) --------
# LOG_LEVEL=info
# HTTP_PROXY=
# HTTPS_PROXY=

# =============================================================
# Notes
# - Copy this file to .env.alpha-vantage-proxy-api (root) for local tools that read it.
# - Copy env.sample to functions/.env.alpha-vantage-proxy-api for the Functions emulator.
# - Production/staging secrets must live in Secret Manager or service env vars.
# =============================================================
