    "dotenv": "^16.5.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/dotenv": "^6.1.1",
    "@types/lodash": "^4.17.17",
    "@types/ms": "^2.1.0",
    "@types/request": "^2.48.12",
    "@types/tough-cookie": "^4.0.5",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.7.3"
  },
  "private": true
