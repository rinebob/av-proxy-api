{
  "name": "functions",
  "scripts": {
    "copy-shared": "npm --prefix ../shared run build && npx cpx \"../shared/lib/**/*\" \"lib/shared\"",
    "copy-shared:watch": "npm --prefix ../shared run build && npx cpx \"../shared/lib/**/*\" \"lib/shared\" -w",
    "build": "npm run copy-shared && tsc -p tsconfig.json && tsc-alias -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "build:watch": "npm run copy-shared && tsc --watch -p tsconfig.json & tsc --watch -p scripts/tsconfig.json",
    "dev:watch": "npx concurrently \"npm:copy-shared:watch\" \"tsc --watch -p tsconfig.json\" \"tsc --watch -p scripts/tsconfig.json\"",
    "dev:emu": "npx concurrently \"npm:copy-shared:watch\" \"tsc --watch -p tsconfig.json\" \"tsc --watch -p scripts/tsconfig.json\" \"npm --prefix .. run emulators\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "npm run build && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "ts": "ts-node -r tsconfig-paths/register -P tsconfig.json",
    "ts:scripts": "ts-node -r tsconfig-paths/register -P scripts/tsconfig.json",
    "gcp-build": "npm run build",
    "test:firestore": "ts-node scripts/test-firestore.ts"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/src/index.js",
  "dependencies": {
    "@google-cloud/pubsub": "^5.2.0",
    "@types/node": "22.18.1",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.5.0"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/lodash": "^4.17.17",
    "@types/ms": "^2.1.0",
    "@types/request": "^2.48.12",
    "@types/tough-cookie": "^4.0.5",
    "tsc-alias": "^1.8.10",
    "concurrently": "^9.1.2",
    "cpx": "^1.5.0",
    "firebase-functions-test": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "private": true
}
