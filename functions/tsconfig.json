{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    "typeRoots": [
          "node_modules/@types" // Ensure this is present and correct
    ]
  },
  "compileOnSave": true,
  "include": [
    "src/**/*"
  ],
 "exclude": [
  "node_modules"
 ]
}
