# =============================================================
# env.functions-sample (Version-controlled, non-secret)
# Copy to: functions/.env.alpha-vantage-proxy-api and fill values locally.
# Do NOT commit real secrets.
# =============================================================

# -------- Project & Environment --------
GOOGLE_CLOUD_PROJECT=alpha-vantage-proxy-api
GCLOUD_PROJECT=alpha-vantage-proxy-api
NODE_ENV=development
FUNCTIONS_EMULATOR=true

# -------- Alpha Vantage (emulator convenience only) --------
# Used only by the Functions emulator if set locally; prod uses Secret Manager
LOCAL_EMULATOR_ALPHAVANTAGE_API_KEY=

# For pub/sub emulator activation
ENABLE_DATA_READY_ANNOUNCE=true
DATA_READY_PHASE=pre
ENABLE_RS_SUBSCRIBER=true

# -------- Partner/Webhook Auth (OIDC allowlist) --------
# Comma-separated service account emails allowed to call protected endpoints
ALLOWED_SERVICE_ACCOUNT_EMAILS=

# -------- Firebase Emulators (align with firebase.json) --------
# Pub/Sub in firebase.json uses port 8086
PUBSUB_EMULATOR_HOST=127.0.0.1:8086
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# -------- Misc (optional) --------
# LOG_LEVEL=info
# HTTP_PROXY=
# HTTPS_PROXY=

# =============================================================
# Notes
# - Keep this file checked in without values as documentation.
# - Copy to functions/.env.alpha-vantage-proxy-api for the Functions emulator.
# - Production/staging secrets must live in Secret Manager or service env vars.
# =============================================================
