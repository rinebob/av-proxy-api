# =============================================================
# env.functions-sample (Version-controlled, non-secret)
# Copy to: functions/.env.alpha-vantage-proxy-api and fill values locally.
# Do NOT commit real secrets.
# =============================================================

# -------- Project & Environment --------
NODE_ENV=development
FUNCTIONS_EMULATOR=true

# -------- Alpha Vantage (emulator convenience only) --------
# Used only by the Functions emulator if set locally; prod uses Secret Manager
LOCAL_EMULATOR_ALPHAVANTAGE_API_KEY=

# -------- Historical Options Corpus --------
# GCS bucket for the gzipped, versioned options corpus
OPTIONS_CORPUS_BUCKET=

# GCS bucket for per-contract options time series JSONL files
OPTIONS_TIME_SERIES_BUCKET=

# Admin secret required by the triggerHistoricalOptionsPilot HTTP endpoint.
# The UI/caller must provide this in the x-admin-secret header.
HISTORICAL_OPTIONS_PILOT_ADMIN_SECRET=

# Admin secret required by the triggerHistoricalOptionsTimeSeriesBuild HTTP endpoint.
HISTORICAL_OPTIONS_TIME_SERIES_ADMIN_SECRET=

# Minimum interval (ms) between consecutive Alpha Vantage calls (default: 1000)
ALPHAVANTAGE_MIN_INTERVAL_MS=1000

# =============================================================


# -------- Firebase Emulators (align with firebase.json) --------
# Pub/Sub in firebase.json uses port 8086
PUBSUB_EMULATOR_HOST=127.0.0.1:8086
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# =============================================================
# Notes
# - Keep this file checked in without values as documentation.
# - Copy to functions/.env.alpha-vantage-proxy-api for the Functions emulator.
# - Production/staging secrets must live in Secret Manager or service env vars.
