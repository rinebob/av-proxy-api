{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "outDir": "../lib/scripts",
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["../shared/lib/*"],
      "@shared": ["../shared/lib"],
      "../src/*": ["../src/*"]
    },
    "esModuleInterop": true,
    "moduleResolution": "node",
    "composite": true,
    "tsBuildInfoFile": "../.tsbuildinfo"
  },
  "include": [
    "./**/*.ts",
    "../src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
