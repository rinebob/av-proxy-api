// TODO: Implement dynamic collection loading from a TypeScript configuration file
// See scripts/generate-rules.ts for the script that will generate these rules
// from a TypeScript configuration file for better maintainability

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isBackend() {
      return isAuthenticated() && (
        request.auth.token.firebase.sign_in_provider == 'function' ||
        (request.query.debug == true && request.auth.token.firebase.sign_in_provider == 'debug')
      );
    }

    // List of top-level collections that follow the standard access pattern
    function getStandardCollections() {
      return [
        'tracked-symbols',
        'symbol-data',
        'market-data',
        'economics',
        'news',
      ];
    }

    // Apply standard access rules to all collections in the list
    function isStandardCollection(collection) {
      return getStandardCollections().hasAny([collection]);
    }

    // Standard access pattern for all top-level collections
    match /{collection}/{document=**} {
      allow read: if isAuthenticated() && isStandardCollection(collection);
      allow write: if isBackend() && isStandardCollection(collection);
    }

    // Test collection - more permissive rules for debugging
    match /test_collection/{document} {
      allow read, write: if isAuthenticated();
    }
  }
}