// TODO: Implement dynamic collection loading from a TypeScript configuration file
// See scripts/generate-rules.ts for the script that will generate these rules
// from a TypeScript configuration file for better maintainability

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {


    // 1. Config docs: admin only read/write
    match /config/{document=**} {
      allow read, write: if request.auth.token.admin == true;
    }

    // 2. Tracked symbols: allow reads, admin can write
    match /tracked-symbols/{symbol} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }    

    // 3. Symbol data: allow reads, admin can write (including all subcollections)
    match /symbol-data/{document=**} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // 4. MarketData collection: allow reads, admin can write
    match /market-data/{docId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // 5. News collection: allow reads, deny all writes
    match /news/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // 6. Economics collection: allow reads, admin can write
    match /economics/{docId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // 7. Operational collections for processing runs
    // These are written by backend functions using Admin SDK (bypasses rules).
    // Lock down client access: no writes; reads restricted to admins only.
    match /runs/{runId} {
      allow read: if request.auth.token.admin == true;
      allow write: if false;
    }

    // 8. Health Metrics: allow clients to read only the small latest status doc.
    // UI listens to: /health-metrics/{endpointId}/latest/status
    match /health-metrics/{endpointId}/latest/{docId} {
      allow read: if request.auth != null && docId == 'status';
      allow write: if false;
    }

    // Optional: Default deny for any other collections not explicitly matched
    // match /{document=**} {
    //   allow read, write: if false;
    // }
  }
}