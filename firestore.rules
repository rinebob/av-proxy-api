// TODO: Implement dynamic collection loading from a TypeScript configuration file
// See scripts/generate-rules.ts for the script that will generate these rules
// from a TypeScript configuration file for better maintainability

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. manualFirestoreWriteEnabled toggle doc: only admin users can read/write
    match /config/manualFirestoreWriteEnabled {
      allow read, write: if request.auth.token.admin == true;
    }

    // 2. All other config docs: admin only read/write
    match /config/{document=**} {
      allow read, write: if request.auth.token.admin == true;
    }

    // 3. Tracked symbols: allow reads, admin can write
    match /tracked-symbols/{symbol} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }    

    // 4. Symbol data: allow reads, admin can write (including all subcollections)
    match /symbol-data/{document=**} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // 5. MarketData collection: allow reads, admin can write
    match /market-data/{docId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // 6. News collection: allow reads, deny all writes
    match /news/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // 7. Economics collection: allow reads, admin can write
    match /economics/{docId} {
      allow read: if true;
      allow write: if request.auth.token.admin == true;
    }

    // 8. Operational collections for processing runs
    // These are written by backend functions using Admin SDK (bypasses rules).
    // Lock down client access: no writes; reads restricted to admins only.
    match /runs/{runId} {
      allow read: if request.auth.token.admin == true;
      allow write: if false;
    }

    // Optional: Default deny for any other collections not explicitly matched
    // match /{document=**} {
    //   allow read, write: if false;
    // }
  }
}